# ============================================================
# Smart E-Commerce Analytics Platform — Environment Variables
# ============================================================
# Copy this file to .env and update values before running.

# --- PostgreSQL Database ---
POSTGRES_USER=olist_admin
POSTGRES_PASSWORD=olist_secret_2024
POSTGRES_DB=olist_dw
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Connection URL (used by FastAPI & dbt) ---
DATABASE_URL=postgresql://olist_admin:olist_secret_2024@localhost:5432/olist_dw

# --- Airflow Core ---
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__FERNET_KEY=ZmDfcTF7_60GrrY167zsiPd67pEvs0aGOv2oasOM1Pg=
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__API__AUTH_BACKENDS=airflow.api.auth.backend.basic_auth,airflow.api.auth.backend.session

# --- Airflow DB ---
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://olist_admin:olist_secret_2024@postgres:5432/olist_dw

# --- Airflow Web Server ---
AIRFLOW_WWW_USER_USERNAME=admin
AIRFLOW_WWW_USER_PASSWORD=admin123

# --- Kaggle API (for dataset download) ---
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
